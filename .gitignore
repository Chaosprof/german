# Local upstream word sources. Keep these on developer machines; the curated
# website source of truth is data/. The legacy rule prevents an accidental
# second German-Words checkout at the repository root.
sources/
German-Words/

# Local browser and agent tooling.
.chrome-test/
.agents/
.claude/
.codex/
cc_ui_bridge/

# Python bytecode and interpreter caches.
__pycache__/
*.py[cod]

# Retired Godot prototype and its generated exports/import cache.
godot-runner/

# Development audit trail: reviews, screenshots, baselines and reference stills.
# Kept on developer machines only; the website never loads any of it, and
# GitHub Pages would otherwise publish all of it.
audit/

# Old translation-review output and standalone prototype/test pages.
translation_review_output_folder*/
berlin-slice.html
voice-test.html
voice-test-frame.html

# Blender auto-backups.
*.blend1
